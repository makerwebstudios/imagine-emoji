{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "./worker-configuration.d.ts"
    ]
  },
  "include": [
    "src/**/*.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "src/**/*.check.ts"
  ]
}